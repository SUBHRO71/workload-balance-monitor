{
  "name": "workload-balance-monitor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @workload/web dev",
    "dev:mobile": "pnpm --filter @workload/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:synth": "pnpm --filter @workload/infra synth",
    "mobile:check": "pnpm --filter @workload/mobile exec expo install --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "10.10.0",
    "globals": "^16.5.0",
    "turbo": "2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
